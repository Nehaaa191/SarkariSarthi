# Groq API Configuration (for AI Policy Assistant & Claim Verification)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama3-8b-8192

# Server Port (Flask backend defaults to 5000 in dev; Render automatically injects PORT in production)
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=development

# JWT Secret for Session Tokens (HS256)
JWT_SECRET=sarkari-saathi-production-secure-key-2026

# Database Path / URL (Optional - defaults to local SQLite file sarkari_saathi.db)
# SQLITE_DB_PATH=./sarkari_saathi.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Optional Supabase Integration
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Optional Gmail SMTP Configuration for live Email OTPs (if omitted, devOtp is returned in response)
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password
