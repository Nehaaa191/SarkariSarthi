# ==============================================================================
# SarkariSaathi Backend Environment Variables
# ==============================================================================

# Server Port
PORT=3001

# Application Environment (development | production | test)
NODE_ENV=development

# Frontend Application URL (used for CORS and OAuth redirects)
# Change to 5174 if Vite auto-increments (e.g., port 5173 is taken)
FRONTEND_URL=http://localhost:5174

# JWT Authentication Secrets (must be secure random strings of at least 32 characters)
JWT_SECRET=dev_secret_key_at_least_32_characters_long_sarkari_saathi
JWT_REFRESH_SECRET=dev_refresh_secret_32_characters_long_sarkari_saathi

# Google OAuth2 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Gmail SMTP Configuration for Email OTPs (requires 16-character App Password)
# If left as placeholder in development, OTP will be printed to server console
GMAIL_USER=placeholder@gmail.com
GMAIL_APP_PASSWORD=placeholder_app_password

# Twilio SMS Configuration for Phone OTPs (E.164 phone number)
# If TWILIO_ACCOUNT_SID is left empty or placeholder in development, OTP will be printed to server console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890
